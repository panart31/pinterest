%% Схема базы данных (рисунок 4)
erDiagram
    USERS ||--o{ SESSIONS : "имеет"
    USERS ||--o{ POSTS : "публикует"
    USERS ||--o{ LIKES : "ставит"
    POSTS ||--o{ LIKES : "получает"
    USERS ||--o{ COMMENTS : "пишет"
    POSTS ||--o{ COMMENTS : "собирает"
    USERS ||--o{ MESSAGES : "отправляет"
    USERS ||--o{ MESSAGES : "получает"

    USERS {
        int id PK
        string username UK
        string display_name
        string password_hash
        string salt
        string created_at
    }

    SESSIONS {
        string token PK
        int user_id FK
        string expires_at
    }

    POSTS {
        int id PK
        int user_id FK
        string filename
        string caption
        string created_at
    }

    LIKES {
        int post_id PK
        int user_id PK
    }

    COMMENTS {
        int id PK
        int post_id FK
        int user_id FK
        string text
        string created_at
    }

    MESSAGES {
        int id PK
        int sender_id FK
        int recipient_id FK
        string text
        string created_at
        int is_read
    }
